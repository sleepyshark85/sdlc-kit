# The .NET style the build enforces (EnforceCodeStyleInBuild, warnings as errors). Raise a rule here when review keeps
# finding what it detects, one rule at a time, each with the finding that justified it.
root = true

[*.cs]
indent_style = space
indent_size = 4
insert_final_newline = true

# Accessibility modifiers always stated, so "private by default" is visible.
dotnet_style_require_accessibility_modifiers = always:warning
dotnet_diagnostic.IDE0040.severity = warning

# Unused members and parameters are dead code.
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
dotnet_diagnostic.IDE0060.severity = warning

# File-scoped namespaces and one using block, sorted.
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning
dotnet_sort_system_directives_first = true
dotnet_diagnostic.IDE0005.severity = warning

# A member that touches no instance state is static.
dotnet_diagnostic.CA1822.severity = warning

# The public API file: a new public item must be declared in PublicAPI.Unshipped.txt.
dotnet_diagnostic.RS0016.severity = warning
dotnet_diagnostic.RS0017.severity = warning

[{**/tests/**.cs,**/samples/**.cs}]
# Tests and samples are not a public API.
dotnet_diagnostic.CS1591.severity = none
dotnet_diagnostic.RS0016.severity = none
dotnet_diagnostic.RS0017.severity = none
